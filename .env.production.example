# ==============================================================================
# CampusRide Enterprise - Production Environment Configuration Template
# Copy this file to .env.production on your deployment server:
# cp .env.production.example .env.production
# ==============================================================================

# Core Application Settings
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="CampusRide Enterprise"
VERSION="1.0.0"

# Relational Database (PostgreSQL with PostGIS)
# Generate a strong password: openssl rand -base64 24
POSTGRES_USER=campusride_admin
POSTGRES_PASSWORD=replace_with_strong_random_db_password_min_32_chars
POSTGRES_DB=campusride_production

# Redis Cache & Telematics Broker
# Generate a strong password: openssl rand -hex 16
REDIS_PASSWORD=replace_with_strong_redis_auth_password

# Authentication & Cryptographic Secrets
# MANDATORY: Generate a high-entropy 256-bit secret: openssl rand -hex 64
JWT_SECRET=replace_with_high_entropy_hex_string_64_characters_min
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# CORS Allowed Origins
# Specify exact production domain(s) - NEVER use wildcard '*' in production
BACKEND_CORS_ORIGINS=["https://campusride.yourdomain.com"]

# External Security APIs
CHECK_PWNED_PASSWORDS=true
PWNED_PASSWORDS_TIMEOUT_SECONDS=3.0
SSL_VERIFY_EXTERNAL_APIS=true

# Telematics & GPS Parameters
GPS_SIMULATION_INTERVAL_SECONDS=2
GPS_UPDATE_BATCH_SIZE=20

# Optional: Cloudflare Turnstile Bot Defense
# TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key

# Optional: Twilio SMS / Emergency Alerts
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER="+1234567890"

# Optional: Sentry Error & Anomaly Telemetry
# SENTRY_DSN=https://your_sentry_key@sentry.io/project_id
