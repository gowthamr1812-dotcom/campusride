# CampusRide Environment Configuration Template
PROJECT_NAME="CampusRide"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS & Frontend URL
FRONTEND_URL="http://localhost:5173"
BACKEND_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]'

# Database Configuration (PostgreSQL with PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=campusride
POSTGRES_PASSWORD=campusride_secure_pass
POSTGRES_DB=campusride_db
DATABASE_URL="postgresql+psycopg2://campusride:campusride_secure_pass@localhost:5432/campusride_db"
# Fallback / Unit Test Database (SQLite allowed for zero-dependency test runs)
TEST_DATABASE_URL="sqlite:///./test_campusride.db"

# JWT Security
JWT_SECRET=replace_with_a_secure_random_key_in_production_min_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# AI Assistant & Predictions
AI_PROVIDER="mock"
AI_API_KEY=""

# GPS Simulation & Realtime
GPS_SIMULATION_INTERVAL_SECONDS=2
GPS_UPDATE_BATCH_SIZE=20

# Frontend Environment Variables (exposed via Vite)
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_WS_URL="ws://localhost:8000/ws"
